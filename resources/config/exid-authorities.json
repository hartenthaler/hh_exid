{
  "version": 1,
  "defaults_version": 4,
  "authorities": [
    {
      "key": "wikidata",
      "label": "Wikidata",
      "type_uris": ["https://www.wikidata.org/entity/"],
      "value_pattern": "Q[1-9][0-9]*",
      "allowed_hosts": ["www.wikidata.org"],
      "contexts": ["*"]
    },
    {
      "key": "factgrid",
      "label": "FactGrid",
