<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Fisharebest\Webtrees\I18N;

/** @var string $title */
/** @var string $description */
/** @var string $selected_tag */
/** @var string $authority_catalogue_json */
/** @var bool $authority_catalogue_writable */
/** @var list<array{source_file:string,label:string,language:string,uri:string,documentation:list<string>}> $gedcom_types */
?>

<?= view('components/breadcrumbs', [
    'links' => [route(ControlPanel::class) => I18N::translate('Control panel'), $title],
]) ?>

<h1><?= e($title) ?></h1>
<p><?= e($description) ?></p>

<form method="post">
    <?= csrf_field() ?>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="exid-tag"><?= I18N::translate('Tag for new external identifiers') ?></label>
        <div class="col-sm-9">
            <select class="form-select" id="exid-tag" name="exid_tag">
                <option value="EXID" <?= $selected_tag === 'EXID' ? 'selected' : '' ?>><?= e(I18N::translate('EXID (GEDCOM 7)')) ?></option>
                <option value="_EXID" <?= $selected_tag === '_EXID' ? 'selected' : '' ?>><?= e(I18N::translate('_EXID (GEDCOM 5.5.1)')) ?></option>
            </select>
            <div class="form-text"><?= I18N::translate('Choose which GEDCOM tag should be generated when a new external identifier is added.') ?></div>
        </div>
    </div>

    <h2><?= I18N::translate('Custom EXID authorities') ?></h2>
    <p><?= I18N::translate('Edit the module-owned authority catalogue as JSON. It is used in addition to the official GEDCOM 7 registry.') ?></p>
    <?php if (!$authority_catalogue_writable) : ?>
        <div class="alert alert-warning">
            <?= I18N::translate('The authority catalogue in the webtrees data directory is not writable. Adjust its permissions before saving changes.') ?>
        </div>
    <?php endif ?>
    <div class="mb-3">
        <label class="form-label" for="authority-catalogue-json"><?= I18N::translate('exid-authorities.json') ?></label>
        <textarea class="form-control font-monospace" id="authority-catalogue-json" name="authority_catalogue_json" rows="18" spellcheck="false"<?= $authority_catalogue_writable ? '' : ' readonly' ?>><?= e($authority_catalogue_json) ?></textarea>
        <div class="form-text">
            <?= I18N::translate('Each authority must define a key, label, one or more HTTPS TYPE URIs, a value pattern and at least one allowed host. Duplicate TYPE URIs are rejected.') ?>
        </div>
    </div>

    <h2><?= I18N::translate('GEDCOM 7 EXID registry') ?></h2>
    <p><?= I18N::translate('The official GEDCOM 7 registry is shown for comparison only and cannot be edited here.') ?></p>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th><?= I18N::translate('Name') ?></th>
                    <th><?= I18N::translate('TYPE URI') ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($gedcom_types as $type) : ?>
                    <tr>
                        <td><?= e($type['label']) ?></td>
                        <td><code><?= e($type['uri']) ?></code></td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
    </div>

    <button class="btn btn-primary" type="submit"><?= I18N::translate('Save') ?></button>
</form>
