<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Fisharebest\Webtrees\I18N;

/** @var string $title */
/** @var string $description */
/** @var string $selected_tag */
/** @var list<array{key:string,label:string,type_uris:list<string>,value_pattern:string,allowed_hosts:list<string>,contexts:list<string>}> $authorities */
/** @var bool $authority_catalogue_writable */
/** @var list<array{source_file:string,label:string,language:string,uri:string,documentation:list<string>,contexts:list<string>}> $gedcom_types */
?>

<?= view('components/breadcrumbs', [
    'links' => [route(ControlPanel::class) => I18N::translate('Control panel'), $title],
]) ?>

<h1><?= e($title) ?></h1>
<p><?= e($description) ?></p>

<form method="post">
    <?= csrf_field() ?>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="exid-tag"><?= I18N::translate('Tag for new external identifiers') ?></label>
        <div class="col-sm-9">
            <select class="form-select" id="exid-tag" name="exid_tag">
                <option value="EXID" <?= $selected_tag === 'EXID' ? 'selected' : '' ?>><?= e(I18N::translate('EXID (GEDCOM 7)')) ?></option>
                <option value="_EXID" <?= $selected_tag === '_EXID' ? 'selected' : '' ?>><?= e(I18N::translate('_EXID (GEDCOM 5.5.1)')) ?></option>
            </select>
            <div class="form-text"><?= I18N::translate('Choose which GEDCOM tag should be generated when a new external identifier is added.') ?></div>
        </div>
    </div>

    <h2><?= I18N::translate('Custom EXID authorities') ?></h2>
    <p><?= I18N::translate('Manage the module-owned authority catalogue in the table below. It is used in addition to the official GEDCOM 7 registry.') ?></p>
    <?php if (!$authority_catalogue_writable) : ?>
        <div class="alert alert-warning">
            <?= I18N::translate('The authority catalogue in the webtrees data directory is not writable. Adjust its permissions before saving changes.') ?>
        </div>
    <?php endif ?>
    <div class="table-responsive mb-3">
        <table class="table table-sm align-middle" id="exid-authority-table">
            <thead>
                <tr>
                    <th><?= I18N::translate('Key') ?></th>
                    <th><?= I18N::translate('Label') ?></th>
                    <th><?= I18N::translate('TYPE URIs') ?></th>
                    <th><?= I18N::translate('Value pattern') ?></th>
                    <th><?= I18N::translate('Allowed hosts') ?></th>
                    <th><?= I18N::translate('Compatible contexts') ?></th>
                    <th><span class="visually-hidden"><?= I18N::translate('Actions') ?></span></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($authorities as $index => $authority) : ?>
                    <tr data-exid-authority-row>
                        <td><input class="form-control" name="authorities[<?= e((string) $index) ?>][key]" value="<?= e($authority['key']) ?>" required maxlength="80"></td>
                        <td><input class="form-control" name="authorities[<?= e((string) $index) ?>][label]" value="<?= e($authority['label']) ?>" required maxlength="200"></td>
                        <td><textarea class="form-control" name="authorities[<?= e((string) $index) ?>][type_uris]" rows="2" required><?= e(implode("\n", $authority['type_uris'])) ?></textarea></td>
                        <td><input class="form-control font-monospace" name="authorities[<?= e((string) $index) ?>][value_pattern]" value="<?= e($authority['value_pattern']) ?>" maxlength="200"></td>
                        <td><textarea class="form-control" name="authorities[<?= e((string) $index) ?>][allowed_hosts]" rows="2" required><?= e(implode("\n", $authority['allowed_hosts'])) ?></textarea></td>
                        <td><textarea class="form-control font-monospace" name="authorities[<?= e((string) $index) ?>][contexts]" rows="2" placeholder="*"><?= e(implode("\n", $authority['contexts'])) ?></textarea></td>
                        <td><button class="btn btn-outline-danger" type="button" data-exid-authority-remove><?= I18N::translate('Remove') ?></button></td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
    </div>
    <button class="btn btn-secondary mb-3" type="button" id="exid-authority-add"><?= I18N::translate('Add authority') ?></button>
    <div class="form-text mb-3">
        <?= I18N::translate('Enter one value per line in each field. Compatible contexts accept comma-separated values such as INDI, PLAC, _LOC or *. Duplicate TYPE URIs are rejected.') ?>
        <?= I18N::translate('The Value pattern field is optional; an empty value accepts any safe identifier value.') ?>
    </div>

    <template id="exid-authority-template">
        <tr data-exid-authority-row>
            <td><input class="form-control" name="authorities[__INDEX__][key]" required maxlength="80"></td>
            <td><input class="form-control" name="authorities[__INDEX__][label]" required maxlength="200"></td>
            <td><textarea class="form-control" name="authorities[__INDEX__][type_uris]" rows="2" required></textarea></td>
            <td><input class="form-control font-monospace" name="authorities[__INDEX__][value_pattern]" maxlength="200"></td>
            <td><textarea class="form-control" name="authorities[__INDEX__][allowed_hosts]" rows="2" required></textarea></td>
            <td><textarea class="form-control font-monospace" name="authorities[__INDEX__][contexts]" rows="2" placeholder="*"></textarea></td>
            <td><button class="btn btn-outline-danger" type="button" data-exid-authority-remove><?= I18N::translate('Remove') ?></button></td>
        </tr>
    </template>

    <script>
        (function () {
            const table = document.querySelector('#exid-authority-table tbody');
            const template = document.querySelector('#exid-authority-template');
            const add = document.querySelector('#exid-authority-add');
            let index = <?= count($authorities) ?>;

            if (!table || !template || !add) {
                return;
            }

            add.addEventListener('click', function () {
                table.insertAdjacentHTML('beforeend', template.innerHTML.replaceAll('__INDEX__', String(index++)));
            });

            table.addEventListener('click', function (event) {
                const button = event.target.closest('[data-exid-authority-remove]');
                if (button) {
                    button.closest('[data-exid-authority-row]').remove();
                }
            });
        }());
    </script>

    <h2><?= I18N::translate('GEDCOM 7 EXID registry') ?></h2>
    <p><?= I18N::translate('The official GEDCOM 7 registry is shown for comparison only. Its compatible contexts can be assigned here; the registry data itself cannot be edited.') ?></p>
    <button class="btn btn-secondary mb-3" type="submit" name="reset_gedcom_contexts" value="1"><?= I18N::translate('Reset registry contexts to defaults') ?></button>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th><?= I18N::translate('Name') ?></th>
                    <th><?= I18N::translate('TYPE URI') ?></th>
                    <th><?= I18N::translate('Compatible contexts') ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($gedcom_types as $index => $type) : ?>
                    <tr>
                        <td><?= e($type['label']) ?></td>
                        <td><code><?= e($type['uri']) ?></code></td>
                        <td><textarea class="form-control form-control-sm font-monospace" name="gedcom_contexts[<?= e((string) $index) ?>]" rows="2" placeholder="*"><?= e(implode("\n", $type['contexts'])) ?></textarea></td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
    </div>

    <button class="btn btn-primary" type="submit"><?= I18N::translate('Save') ?></button>
</form>
